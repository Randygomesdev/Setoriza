# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — Copie para .env.prod e preencha antes do deploy
# NUNCA commite o .env.prod real no repositório!
# ─────────────────────────────────────────────────────────────────────────────

# Versão da aplicação (usada nas tags das imagens Docker)
APP_VERSION=1.0.0

# ─── Banco de Dados ─────────────────────────────────────────────────────────
POSTGRES_USER=setoriza_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ─── MinIO (S3 local / ou Cloudflare R2 em produção) ────────────────────────
MINIO_ROOT_USER=TROQUE_POR_ACCESS_KEY
MINIO_ROOT_PASSWORD=TROQUE_POR_SECRET_KEY

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=TROQUE_POR_CHAVE_ALEATORIA_256_BITS

# ─── Evolution API (WhatsApp) ────────────────────────────────────────────────
EVOLUTION_SERVER_URL=https://seu-dominio.com/evolution
EVOLUTION_APIKEY=TROQUE_POR_APIKEY_FORTE
EVOLUTION_INSTANCE=setoriza-prod

# ─── URLs da Aplicação ───────────────────────────────────────────────────────
# URL pública do gateway (para registro de webhook na Evolution API)
SETORIZA_BASE_URL=https://api.seu-dominio.com
