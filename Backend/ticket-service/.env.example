SERVER_PORT=8082

# Database configuration
TICKET_DB_URL=jdbc:postgresql://localhost:5432/ticket_db
TICKET_DB_USERNAME=postgres
TICKET_DB_PASSWORD=postgres

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO/S3 configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=setoriza-medias

# Evolution API (WhatsApp Gateway)
EVOLUTION_URL=http://localhost:8085
EVOLUTION_APIKEY=setoriza_api_key_12345
EVOLUTION_INSTANCE=setoriza-dev

# Setoriza System Configuration
SETORIZA_BASE_URL=http://host.docker.internal:8080
